{
  "expo": {
    "name": "QuantoTá",
    "slug": "quantota",
    "scheme": "quantota",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.quantota.app"
    },
    "android": {
      "package": "br.com.quantota.app",
      "adaptiveIcon": {
        "backgroundColor": "#F3F7F4"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}